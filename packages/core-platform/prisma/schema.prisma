  school             School              @relation("PaymentSchool", fields: [schoolId], references: [id])
  student            Student             @relation("PaymentStudent", fields: [studentId], references: [id])
  tenant             Tenant              @relation("PaymentTenant", fields: [tenantId], references: [id])
