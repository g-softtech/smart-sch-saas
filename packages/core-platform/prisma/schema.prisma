  paidAmount        Decimal               @default(0) @db.Decimal(10, 2)
  status            InvoiceStatus         @default(DRAFT)
  dueDate           DateTime
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  financialPeriodId String?
  adjustments       FinancialAdjustment[]
  lineItems         InvoiceLineItem[]
  academicYear      AcademicYear          @relation(fields: [academicYearId], references: [id])
  feeStructure      FeeStructure?         @relation(fields: [feeStructureId], references: [id])
  financialPeriod   FinancialPeriod?      @relation("InvoiceFinancialPeriod", fields: [financialPeriodId], references: [id], onDelete: Restrict)
  school            School                @relation("InvoiceSchool", fields: [schoolId], references: [id])
  student           Student               @relation("InvoiceStudent", fields: [studentId], references: [id])
  tenant            Tenant                @relation("InvoiceTenant", fields: [tenantId], references: [id])
  term              Term                  @relation(fields: [termId], references: [id])
  allocations       PaymentAllocation[]
  walletAllocations WalletAllocation[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, schoolId, studentId])
