  student        Student  @relation("ReceiptStudent", fields: [studentId], references: [id])
  tenant         Tenant   @relation("ReceiptTenant", fields: [tenantId], references: [id])

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, schoolId, studentId])
  @@map("fin_payment_receipts")
}

model FinancialPeriod {
