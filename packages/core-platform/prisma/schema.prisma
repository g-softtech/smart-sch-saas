generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ModuleKey {
  LIBRARY
  TRANSPORT
  HOSTEL
  CMS
  MARKETPLACE
  AI
}

enum EntitlementStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  EXPIRED
}

model Tenant {
  id                             String                          @id @default(uuid())
  name                           String
  slug                           String                          @unique
  status                         TenantStatus                    @default(ACTIVE)
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  pickupAuthorizations           PickupAuthorization[]
  schools                        School[]
  StudentArrival                 StudentArrival[]
  departures                     StudentDeparture[]
  academicYears                  AcademicYear[]
  arms                           Arm[]
  assessmentTypes                AssessmentType[]
  AssessmentComponent            AssessmentComponent[]
  AssessmentScore                AssessmentScore[]
  AssignmentSubmission           AssignmentSubmission[]
  Assignment                     Assignment[]
  campuses                       Campus[]
  CBTAttempt                     CBTAttempt[]
  CBTExam                        CBTExam[]
  classes                        Class[]
  departments                    Department[]
  GradeBoundary                  GradeBoundary[]
  GradingScale                   GradingScale[]
  subjectGroups                  SubjectGroup[]
  SubjectResult                  SubjectResult[]
  subjects                       Subject[]
  terms                          Term[]
  TimetableEntry                 TimetableEntry[]
  TimetablePeriod                TimetablePeriod[]
  applicants                     Applicant[]
  admissionApplications          AdmissionApplication[]
  AdmissionExam                  AdmissionExam[]
  PaymentTransaction             PaymentTransaction[]
  publishedForms                 PublishedAdmissionForm[]
  admissionReviews               AdmissionReview[]
  attendanceRecords              AttendanceRecord[]
  attendanceRegisters            AttendanceRegister[]
  FeeStructure                   FeeStructure[]                  @relation("FeeStructureTenant")
  Invoice                        Invoice[]                       @relation("InvoiceTenant")
  PaymentReceipt                 PaymentReceipt[]                @relation("ReceiptTenant")
  Payment                        Payment[]                       @relation("PaymentTenant")
  guardianCredentials            GuardianCredential[]
  auditLogs                      AuditLog[]
  roles                          Role[]
  users                          UserTenantMembership[]
  schoolAccess                   UserSchoolAccess[]
  StaffCampusAssignment          StaffCampusAssignment[]
  staffCredentials               StaffCredential[]
  staffProfiles                  StaffProfile[]
  StudentCredential              StudentCredential[]
  guardians                      Guardian[]
  studentPhotos                  StudentPhoto[]
  staffPhotos                    StaffPhoto[]
  students                       Student[]
  entitlements                   TenantEntitlement[]
  schoolModuleSettings           SchoolModuleSetting[]
  teacherSubjectAssignments      TeacherSubjectAssignment[]
  classTeacherAssignments        ClassTeacherAssignment[]
  gradebookSubmissions           GradebookSubmission[]
  scoreAuditLogs                 ScoreAuditLog[]
  workflowAuditLogs              WorkflowAuditLog[]
  assignmentMigrationQuarantines AssignmentMigrationQuarantine[]
  lessonNotes                    LessonNote[]
  lessonNoteAuditLogs            LessonNoteAuditLog[]
  bookCategories                 BookCategory[]
  books                          Book[]
  bookItems                      BookItem[]
  libraryPolicies                LibraryPolicy[]
  bookLoans                      BookLoan[]
  libraryAuditLogs               LibraryAuditLog[]
  TransportVehicle               TransportVehicle[]
  TransportRoute                 TransportRoute[]
  TransportRouteAllocation       TransportRouteAllocation[]
  TransportSubscription          TransportSubscription[]
  CmsSiteConfig                  CmsSiteConfig[]
  CmsPage                        CmsPage[]
  CmsAnnouncement                CmsAnnouncement[]
  CmsMedia                       CmsMedia[]
  CmsNavigationItem              CmsNavigationItem[]

  @@map("plt_tenants")
  AcademicGradingConfig AcademicGradingConfig[]
}

model User {
  id                  String                 @id @default(uuid())
  email               String                 @unique
  passwordHash        String?
  globalRole          GlobalRole             @default(USER)
  emailVerified       DateTime?
  preferredTenantId   String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  deletedAt           DateTime?
  admissionReviews    AdmissionReview[]
  auditLogs           AuditLog[]
  memberships         UserTenantMembership[]
  schoolAccess        UserSchoolAccess[]
  staffProfiles       StaffProfile[]
  students            Student[]
  guardians           Guardian[]
  passwordResetTokens PasswordResetToken[]
  lessonNoteReviews   LessonNote[]           @relation("LessonNoteReviewer")
  CmsPage             CmsPage[]
  CmsAnnouncement     CmsAnnouncement[]
  CmsMedia            CmsMedia[]

  @@map("idm_users")
}

model UserTenantMembership {
  id        String        @id @default(uuid())
  tenantId  String
  userId    String
  roleId    String
  state     IdentityState @default(PROVISIONED)
  isRevoked Boolean       @default(false)
  revokedAt DateTime?
  revokedBy String?
  version   Int           @default(1)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  role      Role          @relation(fields: [roleId], references: [id])
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("idm_tenant_memberships")
}

model UserSchoolAccess {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  schoolId  String
  campusId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  campus    Campus?  @relation(fields: [campusId], references: [id], onDelete: Restrict)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId, campusId])
  @@index([tenantId])
  @@map("idm_user_school_access")
}

model PortalInvitation {
  id          String           @id @default(uuid())
  tenantId    String
  schoolId    String
  userId      String
  tokenHash   String           @unique
  targetType  PortalTargetType
  studentId   String?
  guardianId  String?
  staffId     String?
  expiresAt   DateTime
  isConsumed  Boolean          @default(false)
  consumedAt  DateTime?
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  staff       StaffProfile?    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, studentId])
  @@index([tenantId, guardianId])
  @@index([tenantId, staffId])
  @@map("idm_portal_invitations")
}

enum PortalTargetType {
  STUDENT
  GUARDIAN
  STAFF
}

model Role {
  id          String                 @id @default(uuid())
  tenantId    String
  name        String
  isSystem    Boolean                @default(false)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  permissions RolePermission[]
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships UserTenantMembership[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("idm_roles")
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@map("idm_permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("idm_role_permissions")
}

model School {
  id                        String                     @id @default(uuid())
  tenantId                  String
  name                      String
  publicSlug                String?
  pickupAuthorizations      PickupAuthorization[]
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id])
  StudentArrival            StudentArrival[]
  departures                StudentDeparture[]
  academicYears             AcademicYear[]
  assessmentTypes           AssessmentType[]
  AssessmentComponent       AssessmentComponent[]
  AssessmentScore           AssessmentScore[]
  AssignmentSubmission      AssignmentSubmission[]
  Assignment                Assignment[]
  campuses                  Campus[]
  CBTAttempt                CBTAttempt[]
  CBTExam                   CBTExam[]
  classes                   Class[]
  departments               Department[]
  GradeBoundary             GradeBoundary[]
  GradingScale              GradingScale[]
  subjectGroups             SubjectGroup[]
  SubjectResult             SubjectResult[]
  subjects                  Subject[]
  TimetableEntry            TimetableEntry[]
  TimetablePeriod           TimetablePeriod[]
  applicants                Applicant[]
  admissionApplications     AdmissionApplication[]
  AdmissionExam             AdmissionExam[]
  PaymentTransaction        PaymentTransaction[]
  publishedForms            PublishedAdmissionForm[]
  attendanceRecords         AttendanceRecord[]
  attendanceRegisters       AttendanceRegister[]
  FeeStructure              FeeStructure[]             @relation("FeeStructureSchool")
  Invoice                   Invoice[]                  @relation("InvoiceSchool")
  PaymentReceipt            PaymentReceipt[]           @relation("ReceiptSchool")
  Payment                   Payment[]                  @relation("PaymentSchool")
  userAccess                UserSchoolAccess[]
  staffCredentials          StaffCredential[]
  staffProfiles             StaffProfile[]
  StudentCredential         StudentCredential[]
  studentPhotos             StudentPhoto[]
  staffPhotos               StaffPhoto[]
  students                  Student[]
  moduleSettings            SchoolModuleSetting[]
  teacherSubjectAssignments TeacherSubjectAssignment[]
  classTeacherAssignments   ClassTeacherAssignment[]
  gradebookSubmissions      GradebookSubmission[]
  lessonNotes               LessonNote[]
  lessonNoteAuditLogs       LessonNoteAuditLog[]
  bookCategories            BookCategory[]
  books                     Book[]
  bookItems                 BookItem[]
  libraryPolicies           LibraryPolicy[]
  bookLoans                 BookLoan[]
  libraryAuditLogs          LibraryAuditLog[]
  TransportVehicle          TransportVehicle[]
  TransportRoute            TransportRoute[]
  TransportRouteAllocation  TransportRouteAllocation[]
  TransportSubscription     TransportSubscription[]
  CmsSiteConfig             CmsSiteConfig?
  CmsPage                   CmsPage[]
  CmsAnnouncement           CmsAnnouncement[]
  CmsMedia                  CmsMedia[]
  CmsNavigationItem         CmsNavigationItem[]

  @@unique([tenantId, id])
  AcademicGradingConfig AcademicGradingConfig[]
}

model TenantEntitlement {
  id         String            @id @default(uuid())
  tenantId   String
  moduleKey  ModuleKey
  status     EntitlementStatus @default(ACTIVE)
  validUntil DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@index([tenantId])
  @@map("sys_tenant_entitlements")
}

model SchoolModuleSetting {
  id            String    @id @default(uuid())
  tenantId      String
  schoolId      String
  moduleKey     ModuleKey
  isEnabled     Boolean   @default(false)
  schemaVersion Int       @default(1)
  configJson    Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school School @relation(fields: [tenantId, schoolId], references: [tenantId, id], onDelete: Cascade)

  @@unique([schoolId, moduleKey])
  @@index([tenantId, schoolId])
  @@map("sys_school_module_settings")
}

model StudentPhoto {
  id        String   @id @default(uuid())
  tenantId  String
  schoolId  String
  studentId String   @unique
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@map("stud_photos")
}

model StaffPhoto {
  id        String       @id @default(uuid())
  tenantId  String
  schoolId  String
  staffId   String       @unique
  mimeType  String
  data      Bytes
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  school    School       @relation(fields: [schoolId], references: [id])
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  tenant    Tenant       @relation(fields: [tenantId], references: [id])

  @@map("stf_photos")
}

model AuditLog {
  id            String    @id @default(uuid())
  tenantId      String?
  userId        String?
  action        String
  entity        String
  entityId      String
  metadata      Json?
  correlationId String?
  retentionDate DateTime?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id])

  @@index([tenantId, entity, entityId])
  @@map("idm_audit_logs")
}

model PlatformAuditLog {
  id        String   @id @default(uuid())
  action    String
  actorId   String
  metadata  Json
  createdAt DateTime @default(now())
}

model OutboxQueue {
  id            String       @id @default(uuid())
  eventId       String       @unique
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  errorMessage  String?
  aggregateId   String
  tenantId      String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, nextAttemptAt])
  @@index([aggregateId])
  @@index([tenantId])
}

model DomainEventLog {
  eventId       String   @id
  eventType     String
  aggregateId   String
  aggregateType String
  version       Int      @default(1)
  occurredAt    DateTime @default(now())
  correlationId String
  causationId   String?
  tenantId      String
  payload       Json
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([aggregateId])
}

model IdempotencyRecord {
  id        String   @id
  eventId   String
  consumer  String
  createdAt DateTime @default(now())

  @@index([eventId])
}

model Campus {
  id                  String                  @id @default(uuid())
  tenantId            String
  schoolId            String
  name                String
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  studentArrivals     StudentArrival[]
  studentDepartures   StudentDeparture[]
  arms                Arm[]
  school              School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant              Tenant                  @relation(fields: [tenantId], references: [id])
  attendanceRegisters AttendanceRegister[]
  userAccess          UserSchoolAccess[]
  staffAssignments    StaffCampusAssignment[]
  enrollments         Enrollment[]
  lessonNotes         LessonNote[]
  bookItems           BookItem[]
  bookLoans           BookLoan[]
  TransportVehicle    TransportVehicle[]
  TransportRoute      TransportRoute[]

  @@unique([tenantId, schoolId, name])
  @@index([tenantId])
  @@map("acd_campuses")
}

model AcademicYear {
  id                        String                     @id @default(uuid())
  tenantId                  String
  schoolId                  String
  name                      String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  endDate                   DateTime?                  @db.Date
  startDate                 DateTime?                  @db.Date
  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id])
  AssessmentComponent       AssessmentComponent[]
  SubjectResult             SubjectResult[]
  terms                     Term[]
  TimetableEntry            TimetableEntry[]
  TimetablePeriod           TimetablePeriod[]
  publishedForms            PublishedAdmissionForm[]
  attendanceRegisters       AttendanceRegister[]
  FeeStructure              FeeStructure[]
  Invoice                   Invoice[]
  enrollments               Enrollment[]
  teacherSubjectAssignments TeacherSubjectAssignment[]
  classTeacherAssignments   ClassTeacherAssignment[]
  gradebookSubmissions      GradebookSubmission[]
  lessonNotes               LessonNote[]
  TransportRouteAllocation  TransportRouteAllocation[]
  TransportSubscription     TransportSubscription[]

  @@unique([tenantId, schoolId, name])
  @@index([tenantId])
  @@map("acd_academic_years")
  AcademicGradingConfig AcademicGradingConfig[]
}

model Term {
  id                        String                     @id @default(uuid())
  tenantId                  String
  academicYearId            String
  name                      String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  endDate                   DateTime?                  @db.Date
  startDate                 DateTime?                  @db.Date
  AssessmentComponent       AssessmentComponent[]
  SubjectResult             SubjectResult[]
  academicYear              AcademicYear               @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id])
  TimetableEntry            TimetableEntry[]
  attendanceRegisters       AttendanceRegister[]
  FeeStructure              FeeStructure[]
  Invoice                   Invoice[]
  teacherSubjectAssignments TeacherSubjectAssignment[]
  classTeacherAssignments   ClassTeacherAssignment[]
  gradebookSubmissions      GradebookSubmission[]
  lessonNotes               LessonNote[]
  TransportRouteAllocation  TransportRouteAllocation[]
  TransportSubscription     TransportSubscription[]

  @@unique([tenantId, academicYearId, name])
  @@index([tenantId])
  @@map("acd_terms")
  AcademicGradingConfig AcademicGradingConfig[]
}

model Department {
  id            String         @id @default(uuid())
  tenantId      String
  schoolId      String
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  staffProfiles StaffProfile[]

  @@unique([tenantId, schoolId, name])
  @@index([tenantId])
  @@map("acd_departments")
}

model Class {
  id                        String                     @id @default(uuid())
  tenantId                  String
  schoolId                  String
  name                      String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  arms                      Arm[]
  AssessmentComponent       AssessmentComponent[]
  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id])
  TimetableEntry            TimetableEntry[]
  publishedForms            PublishedAdmissionForm[]
  attendanceRegisters       AttendanceRegister[]
  FeeStructure              FeeStructure[]
  enrollments               Enrollment[]
  teacherSubjectAssignments TeacherSubjectAssignment[]
  classTeacherAssignments   ClassTeacherAssignment[]
  gradebookSubmissions      GradebookSubmission[]
  lessonNotes               LessonNote[]

  @@unique([tenantId, schoolId, name])
  @@index([tenantId])
  @@map("acd_classes")
}

model Arm {
  id                        String                     @id @default(uuid())
  tenantId                  String
  classId                   String
  campusId                  String
  name                      String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  campus                    Campus                     @relation(fields: [campusId], references: [id])
  class                     Class                      @relation(fields: [classId], references: [id])
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id])
  AssessmentComponent       AssessmentComponent[]
  TimetableEntry            TimetableEntry[]
  attendanceRegisters       AttendanceRegister[]
  FeeStructure              FeeStructure[]
  enrollments               Enrollment[]
  teacherSubjectAssignments TeacherSubjectAssignment[]
  classTeacherAssignments   ClassTeacherAssignment[]
  gradebookSubmissions      GradebookSubmission[]
  lessonNotes               LessonNote[]

  @@unique([tenantId, classId, campusId, name])
  @@index([tenantId])
  @@map("acd_arms")
}

model SubjectGroup {
  id        String    @id @default(uuid())
  tenantId  String
  schoolId  String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  subjects  Subject[]

  @@unique([tenantId, schoolId, name])
  @@index([tenantId])
  @@map("acd_subject_groups")
}

model Subject {
  id                        String                     @id @default(uuid())
  tenantId                  String
  schoolId                  String
  name                      String
  subjectGroupId            String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  AssessmentComponent       AssessmentComponent[]
  SubjectResult             SubjectResult[]
  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectGroup              SubjectGroup?              @relation(fields: [subjectGroupId], references: [id])
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id])
  TimetableEntry            TimetableEntry[]
  teacherSubjectAssignments TeacherSubjectAssignment[]
  gradebookSubmissions      GradebookSubmission[]
  lessonNotes               LessonNote[]

  @@unique([tenantId, schoolId, name])
  @@index([tenantId])
  @@map("acd_subjects")
}

model StudentNumberSequence {
  tenantId   String
  schoolId   String
  lastNumber Int    @default(0)

  @@unique([tenantId, schoolId])
  @@map("stud_student_number_sequences")
}

model Student {
  id                    String                  @id @default(uuid())
  tenantId              String
  schoolId              String
  userId                String?
  studentNumber         String
  firstName             String
  lastName              String
  middleName            String?
  email                 String?
  dateOfBirth           DateTime?
  gender                GenderEnum
  nationality           String?
  status                StudentStatus           @default(ACTIVE)
  admissionDate         DateTime
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  pickupAuthorizations  PickupAuthorization[]
  StudentArrival        StudentArrival[]
  departures            StudentDeparture[]
  AssignmentSubmission  AssignmentSubmission[]
  CBTAttempt            CBTAttempt[]
  admissionApplication  AdmissionApplication?
  attendanceRecords     AttendanceRecord[]
  Invoice               Invoice[]               @relation("InvoiceStudent")
  PaymentReceipt        PaymentReceipt[]        @relation("ReceiptStudent")
  Payment               Payment[]               @relation("PaymentStudent")
  credentials           StudentCredential[]
  enrollments           Enrollment[]
  photo                 StudentPhoto?
  guardians             StudentGuardian[]
  bookLoans             BookLoan[]
  school                School                  @relation(fields: [schoolId], references: [id])
  tenant                Tenant                  @relation(fields: [tenantId], references: [id])
  user                  User?                   @relation(fields: [userId], references: [id])
  TransportSubscription TransportSubscription[]

  @@unique([tenantId, schoolId, studentNumber])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, schoolId, status])
  @@map("stud_students")
}

model Guardian {
  id                   String                @id @default(uuid())
  tenantId             String
  userId               String?
  firstName            String
  lastName             String
  phone                String?
  email                String?
  address              String?
  occupation           String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  pickupAuthorizations PickupAuthorization[]
  departures           StudentDeparture[]
  credentials          GuardianCredential[]
  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  user                 User?                 @relation(fields: [userId], references: [id])
  students             StudentGuardian[]

  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("stud_guardians")
}

model StudentGuardian {
  id                 String               @id @default(uuid())
  tenantId           String
  studentId          String
  guardianId         String
  relationship       GuardianRelationship
  isPrimary          Boolean              @default(false)
  isEmergencyContact Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  guardian           Guardian             @relation(fields: [guardianId], references: [id])
  student            Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([tenantId])
  @@map("stud_student_guardians")
}

model StudentCredential {
  id               String           @id @default(uuid())
  tenantId         String
  schoolId         String
  studentId        String
  credentialType   CredentialType
  credentialHash   String
  status           CredentialStatus @default(ISSUED)
  revocationReason String?
  issuedAt         DateTime         @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  school           School           @relation(fields: [schoolId], references: [id])
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant           Tenant           @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, credentialHash])
  @@index([tenantId, schoolId])
  @@index([studentId])
  @@map("stud_credentials")
}

model Enrollment {
  id                String             @id @default(uuid())
  tenantId          String
  studentId         String
  schoolId          String
  academicYearId    String
  classId           String
  armId             String?
  status            EnrollmentStatus   @default(ACTIVE)
  enrolledAt        DateTime           @default(now())
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  campusId          String?
  SubjectResult     SubjectResult[]
  attendanceRecords AttendanceRecord[]
  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id])
  arm               Arm?               @relation(fields: [armId], references: [id], onDelete: Restrict)
