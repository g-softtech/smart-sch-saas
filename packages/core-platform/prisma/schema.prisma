  updatedAt        DateTime     @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, schoolId, borrowerType])
  @@map("lib_policies")
}

model BookLoan {
  id             String         @id @default(uuid())
  tenantId       String
  schoolId       String
  campusId       String?
  bookItemId     String
  borrowerType   BorrowerType
  studentId      String?
  staffProfileId String?
  issuedById     String
  issuedAt       DateTime       @default(now())
  dueDate        DateTime
  returnedAt     DateTime?
  status         BookLoanStatus @default(ISSUED)
  fineAmount     Decimal        @default(0.00) @db.Decimal(10, 2)
  invoiceId      String?        @unique
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  bookItem     BookItem      @relation(fields: [bookItemId], references: [id], onDelete: Restrict)
  campus       Campus?       @relation(fields: [campusId], references: [id], onDelete: Restrict)
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student?      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  staffProfile StaffProfile? @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, schoolId, studentId])
  @@index([tenantId, schoolId, staffProfileId])
  @@index([tenantId, schoolId, status])
  @@map("lib_book_loans")
}

model LibraryAuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  schoolId  String
  userId    String
  action    String
  details   Json?
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, schoolId, userId])
  @@map("lib_audit_logs")
}

// --- Phase 6D Transport & Fleet Management ---

enum TransportVehicleStatus {
  ACTIVE
  IN_MAINTENANCE
  RETIRED
}

enum TransportRouteDirection {
  PICKUP
  DROP_OFF
}

enum TransportRouteStatus {
  ACTIVE
  INACTIVE
}

enum TransportSubscriptionStatus {
  ACTIVE
  CANCELLED
}

model TransportVehicle {
  id                 String                 @id @default(uuid())
  tenantId           String
  schoolId           String
  campusId           String?
  registrationNumber String
  capacity           Int
  status             TransportVehicleStatus @default(ACTIVE)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  campus      Campus?                    @relation(fields: [campusId], references: [id], onDelete: Restrict)
  school      School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  allocations TransportRouteAllocation[]

  @@unique([tenantId, registrationNumber])
  @@index([tenantId, schoolId])
  @@map("trp_vehicles")
}

model TransportRoute {
  id        String                  @id @default(uuid())
  tenantId  String
  schoolId  String
  campusId  String?
  name      String
  direction TransportRouteDirection
  status    TransportRouteStatus    @default(ACTIVE)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  campus      Campus?                    @relation(fields: [campusId], references: [id], onDelete: Restrict)
  school      School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  allocations TransportRouteAllocation[]
  stops       TransportRouteStop[]

  @@index([tenantId, schoolId])
  @@map("trp_routes")
}

model TransportRouteStop {
  id            String   @id @default(uuid())
  routeId       String
  name          String
  estimatedTime String?
  cost          Decimal  @default(0.00) @db.Decimal(10, 2)
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  route         TransportRoute          @relation(fields: [routeId], references: [id], onDelete: Restrict)
  subscriptions TransportSubscription[]

  @@index([routeId])
  @@map("trp_route_stops")
}

model TransportRouteAllocation {
  id             String   @id @default(uuid())
  tenantId       String
  schoolId       String
  routeId        String
  academicYearId String
  termId         String
  vehicleId      String
  driverId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear  AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  term          Term                    @relation(fields: [termId], references: [id], onDelete: Restrict)
  school        School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driver        StaffProfile            @relation(fields: [driverId], references: [id], onDelete: Restrict)
  route         TransportRoute          @relation(fields: [routeId], references: [id], onDelete: Restrict)
  vehicle       TransportVehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  subscriptions TransportSubscription[]

  @@unique([tenantId, schoolId, routeId, termId])
  @@index([tenantId, schoolId])
  @@map("trp_route_allocations")
}

model TransportSubscription {
  id                String                      @id @default(uuid())
  tenantId          String
  schoolId          String
  studentId         String
  academicYearId    String
  termId            String
  routeAllocationId String
  stopId            String
  direction         TransportRouteDirection
  status            TransportSubscriptionStatus @default(ACTIVE)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  academicYear    AcademicYear             @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  term            Term                     @relation(fields: [termId], references: [id], onDelete: Restrict)
  school          School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         Student                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routeAllocation TransportRouteAllocation @relation(fields: [routeAllocationId], references: [id], onDelete: Restrict)
  stop            TransportRouteStop       @relation(fields: [stopId], references: [id], onDelete: Restrict)

  @@index([tenantId, schoolId, studentId])
  @@index([routeAllocationId])
  @@map("trp_subscriptions")
}

// ============================================================================
// PHASE 6F: SCHOOL WEBSITE / CMS
// ============================================================================

enum CmsPublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model CmsSiteConfig {
  id                  String               @id @default(uuid())
  tenantId            String
  schoolId            String               @unique
  status              CmsPublicationStatus @default(DRAFT)
  version             Int                  @default(1)
  logoMediaId         String?
  faviconMediaId      String?
  primaryColor        String?
  themePayload        Json?
  secondaryColor      String?
  contactEmail        String?
  contactPhone        String?
  enableAdmissionsCta Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logoMedia    CmsMedia? @relation("LogoMedia", fields: [logoMediaId], references: [id], onDelete: SetNull)
  faviconMedia CmsMedia? @relation("FaviconMedia", fields: [faviconMediaId], references: [id], onDelete: SetNull)

  @@index([tenantId, schoolId])
  @@map("cms_site_configs")
}

model CmsPage {
  id        String               @id @default(uuid())
  tenantId  String
  schoolId  String
  title     String
  slug      String
  content   String               @db.Text
  status    CmsPublicationStatus @default(DRAFT)
  version   Int                  @default(1)
  authorId  String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([tenantId, schoolId, slug])
  @@map("cms_pages")
}

model CmsAnnouncement {
  id          String               @id @default(uuid())
  tenantId    String
  schoolId    String
  title       String
  content     String               @db.Text
  status      CmsPublicationStatus @default(DRAFT)
  version     Int                  @default(1)
  authorId    String
  publishedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([tenantId, schoolId, status])
  @@map("cms_announcements")
}

model CmsMedia {
  id        String   @id @default(uuid())
  tenantId  String
  schoolId  String
  mimeType  String
  data      Bytes
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school             School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author             User            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  siteConfigsLogo    CmsSiteConfig[] @relation("LogoMedia")
  siteConfigsFavicon CmsSiteConfig[] @relation("FaviconMedia")

  @@index([tenantId, schoolId])
  @@map("cms_media")
}

model CmsNavigationItem {
  id         String   @id @default(uuid())
  tenantId   String
  schoolId   String
  label      String
  targetUrl  String
  orderIndex Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, schoolId, orderIndex])
  @@map("cms_navigation_items")
}

model AcademicGradingConfig {
  id             String       @id @default(uuid())
  tenantId       String
  schoolId       String
  academicYearId String
  termId         String
  gradingScaleId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  term           Term         @relation(fields: [termId], references: [id])
  gradingScale   GradingScale @relation(fields: [gradingScaleId], references: [id])
  school         School       @relation(fields: [schoolId], references: [id])
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, schoolId, academicYearId, termId])
  @@map("acd_academic_grading_configs")
}
