generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                    String                   @id @default(uuid())
  name                  String
  slug                  String                   @unique
  status                TenantStatus             @default(ACTIVE)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  pickupAuthorizations  PickupAuthorization[]
  schools               School[]
  StudentArrival        StudentArrival[]
  departures            StudentDeparture[]
  academicYears         AcademicYear[]
  arms                  Arm[]
  AssessmentComponent   AssessmentComponent[]
  AssessmentScore       AssessmentScore[]
  AssignmentSubmission  AssignmentSubmission[]
  Assignment            Assignment[]
  campuses              Campus[]
  CBTAttempt            CBTAttempt[]
  CBTExam               CBTExam[]
  classes               Class[]
  departments           Department[]
  GradeBoundary         GradeBoundary[]
  GradingScale          GradingScale[]
  subjectGroups         SubjectGroup[]
  SubjectResult         SubjectResult[]
  subjects              Subject[]
  terms                 Term[]
  TimetableEntry        TimetableEntry[]
  TimetablePeriod       TimetablePeriod[]
  applicants            Applicant[]
  admissionApplications AdmissionApplication[]
  AdmissionExam         AdmissionExam[]
  PaymentTransaction    PaymentTransaction[]
  publishedForms        PublishedAdmissionForm[]
  admissionReviews      AdmissionReview[]
  attendanceRecords     AttendanceRecord[]
  attendanceRegisters   AttendanceRegister[]
  FeeStructure          FeeStructure[]           @relation("FeeStructureTenant")
  Invoice               Invoice[]                @relation("InvoiceTenant")
  PaymentReceipt        PaymentReceipt[]         @relation("ReceiptTenant")
  Payment               Payment[]                @relation("PaymentTenant")
  guardianCredentials   GuardianCredential[]
  auditLogs             AuditLog[]
  roles                 Role[]
  users                 UserTenantMembership[]
  schoolAccess          UserSchoolAccess[]
  StaffCampusAssignment StaffCampusAssignment[]
  staffCredentials      StaffCredential[]
  staffProfiles         StaffProfile[]
  StudentCredential     StudentCredential[]
  guardians             Guardian[]
  studentPhotos         StudentPhoto[]
  students              Student[]

  @@map("plt_tenants")
}

model User {
  id                String                 @id @default(uuid())
  email             String                 @unique
  passwordHash      String?
  globalRole        GlobalRole             @default(USER)
  emailVerified     DateTime?
  preferredTenantId String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?
  admissionReviews  AdmissionReview[]
  auditLogs         AuditLog[]
  memberships       UserTenantMembership[]
  schoolAccess      UserSchoolAccess[]
  staffProfiles     StaffProfile[]

  @@map("idm_users")
}

model UserTenantMembership {
  id        String        @id @default(uuid())
  tenantId  String
  userId    String
  roleId    String
  state     IdentityState @default(PROVISIONED)
  isRevoked Boolean       @default(false)
  revokedAt DateTime?
  revokedBy String?
  version   Int           @default(1)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  role      Role          @relation(fields: [roleId], references: [id])
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("idm_tenant_memberships")
}

model UserSchoolAccess {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  schoolId  String
  campusId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  campus    Campus?  @relation(fields: [campusId], references: [id], onDelete: Restrict)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId, campusId])
  @@index([tenantId])
  @@map("idm_user_school_access")
}

model Role {
  id          String                 @id @default(uuid())
  tenantId    String
  name        String
  isSystem    Boolean                @default(false)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  permissions RolePermission[]
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships UserTenantMembership[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("idm_roles")
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@map("idm_permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("idm_role_permissions")
}

model School {
  id                    String                   @id @default(uuid())
  tenantId              String
  name                  String
  pickupAuthorizations  PickupAuthorization[]
  tenant                Tenant                   @relation(fields: [tenantId], references: [id])
  StudentArrival        StudentArrival[]
  departures            StudentDeparture[]
  academicYears         AcademicYear[]
  AssessmentComponent   AssessmentComponent[]
  AssessmentScore       AssessmentScore[]
  AssignmentSubmission  AssignmentSubmission[]
  Assignment            Assignment[]
  campuses              Campus[]
  CBTAttempt            CBTAttempt[]
  CBTExam               CBTExam[]
  classes               Class[]
  departments           Department[]
  GradeBoundary         GradeBoundary[]
  GradingScale          GradingScale[]
  subjectGroups         SubjectGroup[]
  SubjectResult         SubjectResult[]
  subjects              Subject[]
  TimetableEntry        TimetableEntry[]
  TimetablePeriod       TimetablePeriod[]
  applicants            Applicant[]
  admissionApplications AdmissionApplication[]
  AdmissionExam         AdmissionExam[]
  PaymentTransaction    PaymentTransaction[]
  publishedForms        PublishedAdmissionForm[]
  attendanceRecords     AttendanceRecord[]
  attendanceRegisters   AttendanceRegister[]
  FeeStructure          FeeStructure[]           @relation("FeeStructureSchool")
  Invoice               Invoice[]                @relation("InvoiceSchool")
  PaymentReceipt        PaymentReceipt[]         @relation("ReceiptSchool")
  Payment               Payment[]                @relation("PaymentSchool")
  userAccess            UserSchoolAccess[]
  staffCredentials      StaffCredential[]
  staffProfiles         StaffProfile[]
  StudentCredential     StudentCredential[]
  studentPhotos         StudentPhoto[]
  students              Student[]
}

model StudentPhoto {
  id        String   @id @default(uuid())
  tenantId  String
  schoolId  String
  studentId String   @unique
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@map("stud_photos")
}

model AuditLog {
  id            String    @id @default(uuid())
  tenantId      String?
  userId        String?
  action        String
  entity        String
  entityId      String
  metadata      Json?
  correlationId String?
  retentionDate DateTime?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id])

  @@index([tenantId, entity, entityId])
  @@map("idm_audit_logs")
}

model PlatformAuditLog {
  id        String   @id @default(uuid())
  action    String
  actorId   String
  metadata  Json
  createdAt DateTime @default(now())
}

model OutboxQueue {
  id            String       @id @default(uuid())
  eventId       String       @unique
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  errorMessage  String?
  aggregateId   String
  tenantId      String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, nextAttemptAt])
  @@index([aggregateId])
  @@index([tenantId])
}

model DomainEventLog {
  eventId       String   @id
  eventType     String
  aggregateId   String
  aggregateType String
  version       Int      @default(1)
  occurredAt    DateTime @default(now())
  correlationId String
  causationId   String?
  tenantId      String
  payload       Json
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([aggregateId])
}

model IdempotencyRecord {
  id        String   @id
  eventId   String
  consumer  String
  createdAt DateTime @default(now())

  @@index([eventId])
}

model Campus {
  id                  String                  @id @default(uuid())
  tenantId            String
  schoolId            String
  name                String
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  studentArrivals     StudentArrival[]
  studentDepartures   StudentDeparture[]
  arms                Arm[]
  school              School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant              Tenant                  @relation(fields: [tenantId], references: [id])
  attendanceRegisters AttendanceRegister[]
  userAccess          UserSchoolAccess[]
  staffAssignments    StaffCampusAssignment[]
  enrollments         Enrollment[]

  @@unique([tenantId, schoolId, name])
  @@index([tenantId])
  @@map("acd_campuses")
}

model AcademicYear {
  id                  String                   @id @default(uuid())
  tenantId            String
  schoolId            String
  name                String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  endDate             DateTime?                @db.Date
  startDate           DateTime?                @db.Date
  school              School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant              Tenant                   @relation(fields: [tenantId], references: [id])
  AssessmentComponent AssessmentComponent[]
  SubjectResult       SubjectResult[]
  terms               Term[]
  TimetableEntry      TimetableEntry[]
  TimetablePeriod     TimetablePeriod[]
  publishedForms      PublishedAdmissionForm[]
  attendanceRegisters AttendanceRegister[]
  FeeStructure        FeeStructure[]
  Invoice             Invoice[]
  enrollments         Enrollment[]

  @@unique([tenantId, schoolId, name])
  @@index([tenantId])
  @@map("acd_academic_years")
}

model Term {
  id                  String                @id @default(uuid())
  tenantId            String
  academicYearId      String
  name                String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  endDate             DateTime?             @db.Date
  startDate           DateTime?             @db.Date
  AssessmentComponent AssessmentComponent[]
  SubjectResult       SubjectResult[]
  academicYear        AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  tenant              Tenant                @relation(fields: [tenantId], references: [id])
  TimetableEntry      TimetableEntry[]
  attendanceRegisters AttendanceRegister[]
  FeeStructure        FeeStructure[]
  Invoice             Invoice[]

  @@unique([tenantId, academicYearId, name])
  @@index([tenantId])
  @@map("acd_terms")
}

model Department {
  id            String         @id @default(uuid())
  tenantId      String
  schoolId      String
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  staffProfiles StaffProfile[]

  @@unique([tenantId, schoolId, name])
  @@index([tenantId])
  @@map("acd_departments")
}

model Class {
  id                  String                   @id @default(uuid())
  tenantId            String
  schoolId            String
  name                String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  arms                Arm[]
  AssessmentComponent AssessmentComponent[]
  school              School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant              Tenant                   @relation(fields: [tenantId], references: [id])
  TimetableEntry      TimetableEntry[]
  publishedForms      PublishedAdmissionForm[]
  attendanceRegisters AttendanceRegister[]
  FeeStructure        FeeStructure[]
  enrollments         Enrollment[]

  @@unique([tenantId, schoolId, name])
  @@index([tenantId])
  @@map("acd_classes")
}

model Arm {
  id                  String                @id @default(uuid())
  tenantId            String
  classId             String
  campusId            String
  name                String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  campus              Campus                @relation(fields: [campusId], references: [id])
  class               Class                 @relation(fields: [classId], references: [id])
  tenant              Tenant                @relation(fields: [tenantId], references: [id])
  AssessmentComponent AssessmentComponent[]
  TimetableEntry      TimetableEntry[]
  attendanceRegisters AttendanceRegister[]
  FeeStructure        FeeStructure[]
  enrollments         Enrollment[]

  @@unique([tenantId, classId, campusId, name])
  @@index([tenantId])
  @@map("acd_arms")
}

model SubjectGroup {
  id        String    @id @default(uuid())
  tenantId  String
  schoolId  String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  subjects  Subject[]

  @@unique([tenantId, schoolId, name])
  @@index([tenantId])
  @@map("acd_subject_groups")
}

model Subject {
  id                  String                @id @default(uuid())
  tenantId            String
  schoolId            String
  name                String
  subjectGroupId      String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  AssessmentComponent AssessmentComponent[]
  SubjectResult       SubjectResult[]
  school              School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectGroup        SubjectGroup?         @relation(fields: [subjectGroupId], references: [id])
  tenant              Tenant                @relation(fields: [tenantId], references: [id])
  TimetableEntry      TimetableEntry[]

  @@unique([tenantId, schoolId, name])
  @@index([tenantId])
  @@map("acd_subjects")
}

model StudentNumberSequence {
  tenantId   String
  schoolId   String
  lastNumber Int    @default(0)

  @@unique([tenantId, schoolId])
  @@map("stud_student_number_sequences")
}

model Student {
  id                   String                 @id @default(uuid())
  tenantId             String
  schoolId             String
  studentNumber        String
  firstName            String
  lastName             String
  middleName           String?
  dateOfBirth          DateTime?
  gender               GenderEnum
  nationality          String?
  status               StudentStatus          @default(ACTIVE)
  admissionDate        DateTime
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  pickupAuthorizations PickupAuthorization[]
  StudentArrival       StudentArrival[]
  departures           StudentDeparture[]
  AssignmentSubmission AssignmentSubmission[]
  CBTAttempt           CBTAttempt[]
  admissionApplication AdmissionApplication?
  attendanceRecords    AttendanceRecord[]
  Invoice              Invoice[]              @relation("InvoiceStudent")
  PaymentReceipt       PaymentReceipt[]       @relation("ReceiptStudent")
  Payment              Payment[]              @relation("PaymentStudent")
  credentials          StudentCredential[]
  enrollments          Enrollment[]
  photo                StudentPhoto?
  guardians            StudentGuardian[]
  school               School                 @relation(fields: [schoolId], references: [id])
  tenant               Tenant                 @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, schoolId, studentNumber])
  @@index([tenantId])
  @@index([tenantId, schoolId, status])
  @@map("stud_students")
}

model Guardian {
  id                   String                @id @default(uuid())
  tenantId             String
  firstName            String
  lastName             String
  phone                String?
  email                String?
  address              String?
  occupation           String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  pickupAuthorizations PickupAuthorization[]
  departures           StudentDeparture[]
  credentials          GuardianCredential[]
  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  students             StudentGuardian[]

  @@index([tenantId])
  @@map("stud_guardians")
}

model StudentGuardian {
  id                 String               @id @default(uuid())
  tenantId           String
  studentId          String
  guardianId         String
  relationship       GuardianRelationship
  isPrimary          Boolean              @default(false)
  isEmergencyContact Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  guardian           Guardian             @relation(fields: [guardianId], references: [id])
  student            Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([tenantId])
  @@map("stud_student_guardians")
}

model StudentCredential {
  id               String           @id @default(uuid())
  tenantId         String
  schoolId         String
  studentId        String
  credentialType   CredentialType
  credentialHash   String
  status           CredentialStatus @default(ISSUED)
  revocationReason String?
  issuedAt         DateTime         @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  school           School           @relation(fields: [schoolId], references: [id])
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant           Tenant           @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, credentialHash])
  @@index([tenantId, schoolId])
  @@index([studentId])
  @@map("stud_credentials")
}

model Enrollment {
  id                String             @id @default(uuid())
  tenantId          String
  studentId         String
  schoolId          String
  academicYearId    String
  classId           String
  armId             String?
  status            EnrollmentStatus   @default(ACTIVE)
  enrolledAt        DateTime           @default(now())
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  campusId          String?
  SubjectResult     SubjectResult[]
  attendanceRecords AttendanceRecord[]
  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id])
  arm               Arm?               @relation(fields: [armId], references: [id], onDelete: Restrict)
  campus            Campus?            @relation(fields: [campusId], references: [id], onDelete: Restrict)
  class             Class              @relation(fields: [classId], references: [id])
  student           Student            @relation(fields: [studentId], references: [id])

  @@index([tenantId, schoolId])
  @@index([tenantId, academicYearId, classId])
  @@index([tenantId, studentId])
  @@map("stud_enrollments")
}

model PublishedAdmissionForm {
  id             String                 @id @default(uuid())
  publicToken    String                 @unique
  tenantId       String
  schoolId       String
  academicYearId String
  targetClassId  String
  title          String
  fieldsSchema   Json
  workflowStages Json
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  applicationFee Decimal                @default(0.00) @db.Decimal(10, 2)
  currency       String                 @default("NGN")
  applications   AdmissionApplication[]
  academicYear   AcademicYear           @relation(fields: [academicYearId], references: [id])
  school         School                 @relation(fields: [schoolId], references: [id])
  targetClass    Class                  @relation(fields: [targetClassId], references: [id])
  tenant         Tenant                 @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([schoolId])
  @@map("adm_published_forms")
}

model Applicant {
  id           String                 @id @default(uuid())
  tenantId     String
  schoolId     String
  firstName    String
  lastName     String
  dateOfBirth  DateTime?
  gender       GenderEnum?
  email        String?
  school       School                 @relation(fields: [schoolId], references: [id])
  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  applications AdmissionApplication[]

  @@index([tenantId])
  @@index([schoolId])
  @@map("adm_applicants")
}

model AdmissionApplication {
  id              String                 @id @default(uuid())
  trackingToken   String                 @unique
  tenantId        String
  schoolId        String
  applicantId     String
  publishedFormId String
  status          ApplicationStatus      @default(SUBMITTED)
  currentStageKey String?
  formData        Json
  studentId       String?                @unique
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  applicant       Applicant              @relation(fields: [applicantId], references: [id])
  publishedForm   PublishedAdmissionForm @relation(fields: [publishedFormId], references: [id])
  school          School                 @relation(fields: [schoolId], references: [id])
  student         Student?               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  tenant          Tenant                 @relation(fields: [tenantId], references: [id])
  exam            AdmissionExam?
  payments        PaymentTransaction[]
  reviews         AdmissionReview[]

  @@index([tenantId])
  @@index([schoolId])
  @@map("adm_applications")
}

model AdmissionReview {
  id            String                  @id @default(uuid())
  tenantId      String
  applicationId String
  reviewerId    String
  stageKey      String
  decision      AdmissionReviewDecision
  comments      String?
  createdAt     DateTime                @default(now())
  application   AdmissionApplication    @relation(fields: [applicationId], references: [id])
  reviewer      User                    @relation(fields: [reviewerId], references: [id])
  tenant        Tenant                  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([applicationId])
  @@map("adm_reviews")
}

model PaymentTransaction {
  id            String               @id @default(uuid())
  tenantId      String
  schoolId      String
  applicationId String
  reference     String               @unique
  amount        Decimal              @db.Decimal(10, 2)
  currency      String               @default("NGN")
  status        PaymentStatus        @default(PENDING)
  provider      String               @default("PAYSTACK")
  metadata      Json?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  school        School               @relation(fields: [schoolId], references: [id])
  tenant        Tenant               @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([schoolId])
  @@index([applicationId])
  @@map("adm_payment_transactions")
}

model AdmissionExam {
  id            String               @id @default(uuid())
  tenantId      String
  schoolId      String
  applicationId String               @unique
  examDate      DateTime
  venue         String
  score         Float?
  status        ExamStatus           @default(SCHEDULED)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  school        School               @relation(fields: [schoolId], references: [id])
  tenant        Tenant               @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([schoolId])
  @@map("adm_exams")
}

model StaffNumberSequence {
  tenantId   String
  schoolId   String
  lastNumber Int    @default(0)

  @@unique([tenantId, schoolId])
  @@map("stf_staff_number_sequences")
}

model StaffProfile {
  id                String                  @id @default(uuid())
  tenantId          String
  schoolId          String
  userId            String?
  departmentId      String?
  staffNumber       String
  firstName         String
  lastName          String
  middleName        String?
  dateOfBirth       DateTime?
  gender            GenderEnum?
  joiningDate       DateTime
  designation       String?
  type              StaffType
  status            StaffStatus             @default(ACTIVE)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  Assignment        Assignment[]
  CBTExam           CBTExam[]
  TimetableEntry    TimetableEntry[]
  campusAssignments StaffCampusAssignment[]
  credentials       StaffCredential[]
  department        Department?             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  school            School                  @relation(fields: [schoolId], references: [id])
  tenant            Tenant                  @relation(fields: [tenantId], references: [id])
  user              User?                   @relation(fields: [userId], references: [id])

  @@unique([tenantId, schoolId, staffNumber])
  @@index([tenantId])
  @@index([tenantId, schoolId, status])
  @@map("stf_staff_profiles")
}

model StaffCampusAssignment {
  id        String       @id @default(uuid())
  tenantId  String
  staffId   String
  campusId  String
  isPrimary Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  campus    Campus       @relation(fields: [campusId], references: [id])
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  tenant    Tenant       @relation(fields: [tenantId], references: [id])

  @@unique([staffId, campusId])
