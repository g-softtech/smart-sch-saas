generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// DATA CLASSIFICATION CATEGORIES
// 1. GLOBAL: Cross-tenant configuration and root identities.
// 2. TENANT_SCOPED: Strictly owned by a single tenant. Enforced mechanically.
// 3. SYSTEM_ONLY: Background jobs, audit trails of the system itself.
// ----------------------------------------------------------------------------

// ================= GLOBAL MODELS =================
enum GlobalRole {
  SUPER_ADMIN
  USER
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum IdentityState {
  PROVISIONED
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  ARCHIVED
  OFFBOARDED
}

enum OutboxStatus {
  PENDING
  FAILED
  COMPLETED
  QUARANTINED
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users     UserTenantMembership[]
  schoolAccess UserSchoolAccess[]
  roles     Role[]
  auditLogs AuditLog[]
  schools   School[] // TENANT_SCOPED

  // Academics (Batch 3A)
  campuses      Campus[]
  academicYears AcademicYear[]
  terms         Term[]
  departments   Department[]
  classes       Class[]
  arms          Arm[]
  subjectGroups SubjectGroup[]
  subjects      Subject[]

  // Students (Batch 3B)
  students  Student[]
  guardians Guardian[]

  // Admissions (Batch 3C)
  publishedForms        PublishedAdmissionForm[]
  applicants            Applicant[]
  admissionApplications AdmissionApplication[]
  admissionReviews      AdmissionReview[]

  // Staff (Batch 4)
  staffProfiles    StaffProfile[]
  staffCredentials StaffCredential[]

  // Attendance (Batch 5)
  attendanceRegisters AttendanceRegister[]
  attendanceRecords   AttendanceRecord[]

  @@map("plt_tenants")
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  passwordHash      String?
  globalRole        GlobalRole @default(USER)
  emailVerified     DateTime?
  preferredTenantId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  memberships UserTenantMembership[]
  schoolAccess UserSchoolAccess[]
  auditLogs   AuditLog[]

  // Admissions (Batch 3C)
  admissionReviews AdmissionReview[]

  // Staff (Batch 4)
  staffProfiles StaffProfile[]

  @@map("idm_users")
}

// ================= TENANT_SCOPED MODELS =================
model UserTenantMembership {
  id       String @id @default(uuid())
  tenantId String
  userId   String
  roleId   String

  state     IdentityState @default(PROVISIONED)
  isRevoked Boolean       @default(false)
  revokedAt DateTime?
  revokedBy String?
  version   Int           @default(1)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("idm_tenant_memberships")
}

model UserSchoolAccess {
  id       String  @id @default(uuid())
  tenantId String
  userId   String
  schoolId String
  campusId String?

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, schoolId, campusId])
  @@index([tenantId])
  @@map("idm_user_school_access")
}

model Role {
  id       String  @id @default(uuid())
  tenantId String
  name     String
  isSystem Boolean @default(false)

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships UserTenantMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("idm_roles")
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique // e.g., "users:read", "fees:write"
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("idm_permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@map("idm_role_permissions")
}

model School {
  id       String @id @default(uuid())
  tenantId String
  name     String

  tenant Tenant @relation(fields: [tenantId], references: [id])
  userAccess UserSchoolAccess[]

  // Academics (Batch 3A)
  campuses      Campus[]
  academicYears AcademicYear[]
  departments   Department[]
  classes       Class[]
  subjectGroups SubjectGroup[]
  subjects      Subject[]

  // Students (Batch 3B)
  students Student[]

  // Admissions (Batch 3C)
  publishedForms        PublishedAdmissionForm[]
  applicants            Applicant[]
  admissionApplications AdmissionApplication[]

  // Staff (Batch 4)
  staffProfiles    StaffProfile[]
  staffCredentials StaffCredential[]

  // Attendance (Batch 5)
  attendanceRegisters AttendanceRegister[]
  attendanceRecords   AttendanceRecord[]
}

// ================= SYSTEM_ONLY MODELS =================
model AuditLog {
  id       String  @id @default(uuid())
  tenantId String?
  userId   String?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action        String // e.g., "FEE_PAID", "USER_CREATED"
  entity        String // e.g., "Invoice", "User"
  entityId      String
  metadata      Json?
  correlationId String?
  retentionDate DateTime?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@map("idm_audit_logs")
}

model PlatformAuditLog {
  id        String   @id @default(uuid())
  action    String
  actorId   String
  metadata  Json
  createdAt DateTime @default(now())
}

model OutboxQueue {
  id            String       @id @default(uuid())
  eventId       String       @unique
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  errorMessage  String?
  aggregateId   String
  tenantId      String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, nextAttemptAt])
  @@index([aggregateId])
  @@index([tenantId])
}

model DomainEventLog {
  eventId       String   @id
  eventType     String
  aggregateId   String
  aggregateType String
  version       Int      @default(1)
  occurredAt    DateTime @default(now())
  correlationId String
  causationId   String?
  tenantId      String
  payload       Json
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([aggregateId])
}

model IdempotencyRecord {
  id        String   @id
  eventId   String
  consumer  String
  createdAt DateTime @default(now())

  @@index([eventId])
}

// ================= ACADEMICS MODELS (Batch 3A) =================

model Campus {
  id       String @id @default(uuid())
  tenantId String
  schoolId String
  name     String

  tenant Tenant @relation(fields: [tenantId], references: [id])
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  arms   Arm[]
  userAccess UserSchoolAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, schoolId, name])
  @@index([tenantId])
  @@map("acd_campuses")
}

model AcademicYear {
  id       String @id @default(uuid())
  tenantId String
  schoolId String
  name     String

  tenant Tenant @relation(fields: [tenantId], references: [id])
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms  Term[]

  // Students (Batch 3B)
  enrollments Enrollment[]

  // Admissions (Batch 3C)
  publishedForms PublishedAdmissionForm[]

  // Attendance (Batch 5)
  attendanceRegisters AttendanceRegister[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, schoolId, name])
  @@index([tenantId])
  @@map("acd_academic_years")
}

model Term {
  id             String @id @default(uuid())
  tenantId       String
  academicYearId String
  name           String

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  // Attendance (Batch 5)
  attendanceRegisters AttendanceRegister[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, academicYearId, name])
  @@index([tenantId])
  @@map("acd_terms")
}

model Department {
  id       String @id @default(uuid())
  tenantId String
  schoolId String
  name     String

  tenant Tenant @relation(fields: [tenantId], references: [id])
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Staff (Batch 4)
  staffProfiles StaffProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, schoolId, name])
  @@index([tenantId])
  @@map("acd_departments")
}

model Class {
  id       String @id @default(uuid())
  tenantId String
  schoolId String
  name     String

  tenant Tenant @relation(fields: [tenantId], references: [id])
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  arms   Arm[]

  // Students (Batch 3B)
  enrollments Enrollment[]

  // Admissions (Batch 3C)
  publishedForms PublishedAdmissionForm[]

  // Attendance (Batch 5)
  attendanceRegisters AttendanceRegister[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, schoolId, name])
  @@index([tenantId])
  @@map("acd_classes")
}

model Arm {
  id       String @id @default(uuid())
  tenantId String
  classId  String
  campusId String
  name     String

  tenant Tenant @relation(fields: [tenantId], references: [id])
  class  Class  @relation(fields: [classId], references: [id], onDelete: Restrict)
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)

  // Students (Batch 3B)
  enrollments Enrollment[]

  // Attendance (Batch 5)
  attendanceRegisters AttendanceRegister[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, classId, campusId, name])
  @@index([tenantId])
  @@map("acd_arms")
}

model SubjectGroup {
  id       String @id @default(uuid())
  tenantId String
  schoolId String
  name     String

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjects Subject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, schoolId, name])
  @@index([tenantId])
  @@map("acd_subject_groups")
}

model Subject {
  id             String  @id @default(uuid())
  tenantId       String
  schoolId       String
  name           String
  subjectGroupId String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectGroup SubjectGroup? @relation(fields: [subjectGroupId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, schoolId, name])
  @@index([tenantId])
  @@map("acd_subjects")
}

// ================= STUDENTS MODELS (Batch 3B) =================

enum StudentStatus {
  ACTIVE
  SUSPENDED
  GRADUATED
  WITHDRAWN
  TRANSFERRED // Transfer OUT of the institution; internal class changes do not affect this
}

enum GenderEnum {
  MALE
  FEMALE
  OTHER
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED // Closed when student moves to another class/arm; old row retained as history
  WITHDRAWN
  COMPLETED
}

// Atomic sequence counter — system-level only.
// Incremented via raw SQL INSERT ... ON CONFLICT ... DO UPDATE.
// NOT listed in tenantScopedModels; tenantId/schoolId are passed explicitly in SQL.
model StudentNumberSequence {
  tenantId   String
  schoolId   String
  lastNumber Int    @default(0)

  @@unique([tenantId, schoolId])
  @@map("stud_student_number_sequences")
}

model Student {
  id            String        @id @default(uuid())
  tenantId      String
  schoolId      String
  studentNumber String
  firstName     String
  lastName      String
  middleName    String?
  dateOfBirth   DateTime?
  gender        GenderEnum
  nationality   String?
  status        StudentStatus @default(ACTIVE)
  admissionDate DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  guardians   StudentGuardian[]
  enrollments Enrollment[]
  admissionApplication AdmissionApplication?

  // Attendance (Batch 5)
  attendanceRecords AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, schoolId, studentNumber])
  @@index([tenantId])
  @@index([tenantId, schoolId, status])
  @@map("stud_students")
}

model Guardian {
  id         String  @id @default(uuid())
  tenantId   String
  firstName  String
  lastName   String
  phone      String?
  email      String?
  address    String?
  occupation String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  students StudentGuardian[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("stud_guardians")
}

model StudentGuardian {
  id                 String               @id @default(uuid())
  tenantId           String
  studentId          String
  guardianId         String
  relationship       GuardianRelationship
  isPrimary          Boolean              @default(false)
  isEmergencyContact Boolean              @default(false)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, guardianId])
  @@index([tenantId])
  @@map("stud_student_guardians")
}

// ACTIVE uniqueness per (tenantId, studentId, academicYearId) is enforced by a
// PostgreSQL partial unique index added in the migration SQL — NOT a Prisma @@unique.
// This allows multiple historical enrollment rows for the same student/year while
// preventing two ACTIVE rows simultaneously.
// Migration SQL:
//   CREATE UNIQUE INDEX "stud_enrollments_one_active_per_year"
//     ON "stud_enrollments" ("tenantId", "studentId", "academicYearId")
//     WHERE status = 'ACTIVE';
model Enrollment {
  id             String           @id @default(uuid())
  tenantId       String
  studentId      String
  schoolId       String // Denormalised for query performance; always equals student.schoolId
  academicYearId String
  classId        String
  armId          String?
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  notes          String?

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Restrict)
  arm          Arm?         @relation(fields: [armId], references: [id], onDelete: Restrict)

  // Attendance (Batch 5)
  attendanceRecords AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, schoolId])
  @@index([tenantId, academicYearId, classId])
  @@index([tenantId, studentId])
  @@map("stud_enrollments")
}

// ================= ADMISSIONS MODELS (Batch 3C) =================

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WAITLISTED
  ENROLLED
}

enum AdmissionReviewDecision {
  STAGE_PASS
  STAGE_FAIL
  WAITLIST
}

model PublishedAdmissionForm {
  id             String   @id @default(uuid())
  publicToken    String   @unique // Cryptographically secure opaque token
  tenantId       String
  schoolId       String
  academicYearId String
  targetClassId  String   
  title          String
  fieldsSchema   Json     
  workflowStages Json     
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  school       School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  targetClass  Class                  @relation(fields: [targetClassId], references: [id], onDelete: Restrict)
  applications AdmissionApplication[]

  @@index([tenantId])
  @@index([schoolId])
  @@map("adm_published_forms")
}

model Applicant {
  id          String     @id @default(uuid())
  tenantId    String
  schoolId    String
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  gender      GenderEnum?

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  school       School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  applications AdmissionApplication[]

  @@index([tenantId])
  @@index([schoolId])
  @@map("adm_applicants")
}

model AdmissionApplication {
  id              String            @id @default(uuid())
  trackingToken   String            @unique // Cryptographically secure credential
  tenantId        String
  schoolId        String
  applicantId     String
  publishedFormId String
  status          ApplicationStatus @default(SUBMITTED)
  currentStageKey String?
  formData        Json
  studentId       String?           @unique // Linked idempotently upon ENROLLED
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  school        School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  applicant     Applicant              @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  publishedForm PublishedAdmissionForm @relation(fields: [publishedFormId], references: [id], onDelete: Restrict)
  student       Student?               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  reviews       AdmissionReview[]

  @@index([tenantId])
  @@index([schoolId])
  @@map("adm_applications")
}

model AdmissionReview {
  id            String                  @id @default(uuid())
  tenantId      String
  applicationId String
  reviewerId    String
  stageKey      String
  decision      AdmissionReviewDecision
  comments      String?
  createdAt     DateTime                @default(now())

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  reviewer    User                 @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([applicationId])
  @@map("adm_reviews")
}

// ================= STAFF & HR MODELS (Batch 4) =================

enum StaffStatus {
  ACTIVE
  SUSPENDED
  RESIGNED
  RETIRED
  TERMINATED
}

enum StaffType {
  TEACHING
  NON_TEACHING
  ADMINISTRATION
  SUPPORT
}

enum CredentialType {
  QR
  RFID
  BIOMETRIC
}

model StaffNumberSequence {
  tenantId   String
  schoolId   String
  lastNumber Int    @default(0)

  @@unique([tenantId, schoolId])
  @@map("stf_staff_number_sequences")
}

model StaffProfile {
  id            String      @id @default(uuid())
  tenantId      String
  schoolId      String
  userId        String?     // Nullable link to idm_users
  departmentId  String?
  staffNumber   String
  firstName     String
  lastName      String
  middleName    String?
  dateOfBirth   DateTime?
  gender        GenderEnum?
  joiningDate   DateTime
  designation   String?
  type          StaffType
  status        StaffStatus @default(ACTIVE)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  school     School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  department Department?       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  credentials StaffCredential[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, schoolId, staffNumber])
  @@index([tenantId])
  @@index([tenantId, schoolId, status])
  @@map("stf_staff_profiles")
}

model StaffCredential {
  id              String         @id @default(uuid())
  tenantId        String
  schoolId        String
  staffId         String
  credentialType  CredentialType
  credentialHash  String         // HMAC-SHA-256 digest
  isActive        Boolean        @default(true)
  issuedAt        DateTime       @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  school School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  staff  StaffProfile @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@unique([tenantId, credentialHash])
  @@index([tenantId, schoolId])
  @@map("stf_credentials")
}

// ================= ATTENDANCE MODELS (Batch 5) =================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceRegister {
  id             String   @id @default(uuid())
  tenantId       String
  schoolId       String
  academicYearId String
  termId         String
  classId        String
  armId          String?
  date           DateTime @db.Date
  
  createdById      String
  lastModifiedById String
  finalizedById    String?
  isFinalized      Boolean  @default(false)
  finalizedAt      DateTime?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  records AttendanceRecord[]
  
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Restrict)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Restrict)
  arm          Arm?         @relation(fields: [armId], references: [id], onDelete: Restrict)

  @@unique([tenantId, schoolId, id])
  @@index([tenantId, schoolId, date])
  @@map("att_registers")
}

model AttendanceRecord {
  id             String           @id @default(uuid())
  tenantId       String
  schoolId       String
  registerId     String
  studentId      String
  enrollmentId   String
  status         AttendanceStatus
  reason         String?          
  notes          String?
  
  createdById      String
  lastModifiedById String

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  register   AttendanceRegister @relation(fields: [tenantId, schoolId, registerId], references: [tenantId, schoolId, id], onDelete: Restrict)
  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  school     School             @relation(fields: [schoolId], references: [id])
  student    Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment Enrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@unique([registerId, studentId])
  @@index([tenantId, studentId])
  @@map("att_records")
}
