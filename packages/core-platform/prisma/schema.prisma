  @@unique([attemptId, questionId])
  @@map("acd_cbt_attempt_answers")
}

model FeeStructure {
  id             String       @id @default(uuid())
  tenantId       String
  schoolId       String
  academicYearId String
  termId         String
  classId        String
  armId          String?
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          FeeItem[]
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  arm            Arm?         @relation(fields: [armId], references: [id])
  class          Class        @relation(fields: [classId], references: [id])
  school         School       @relation("FeeStructureSchool", fields: [schoolId], references: [id])
  tenant         Tenant       @relation("FeeStructureTenant", fields: [tenantId], references: [id])
  term           Term         @relation(fields: [termId], references: [id])
  invoices       Invoice[]

  @@index([tenantId, schoolId, academicYearId, termId])
  @@map("fin_fee_structures")
}

model FeeItem {
  id             String       @id @default(uuid())
  feeStructureId String
