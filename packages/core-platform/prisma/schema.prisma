  term           Term            @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([tenantId, schoolId, termId, classId, armId, periodId, dayOfWeek])
  @@unique([tenantId, schoolId, termId, teacherId, periodId, dayOfWeek])
